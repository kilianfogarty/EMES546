# ---- Figure B: depth distribution at exposed buildings, per category ----
from matplotlib.patches import Patch

fig, ax = plt.subplots(figsize=(13, 6))
tick_pos, tick_labels = [], []
for i, cat in enumerate(cats):
    b = buildings[buildings["occ_category"] == cat]
    d_present, d_pgw = b["present_depth"].dropna(), b["pgw_depth"].dropna()
    pos = i * 3  # each category gets a pair of boxes with a gap before the next
    for vals, offset, color in [(d_present, 0, "tab:blue"), (d_pgw, 1, "tab:red")]:
        if len(vals) >= MIN_N_BOX:  # tiny samples make misleading boxes
            bp = ax.boxplot(
                vals,
                positions=[pos + offset],
                widths=0.8,
                patch_artist=True,
                showfliers=False,
                medianprops=dict(color="black"),
            )
            bp["boxes"][0].set_facecolor(color)
    tick_pos.append(pos + 0.5)
    tick_labels.append(f"{cat}\nn = {len(d_present)} / {len(d_pgw)}")

ax.set_xticks(tick_pos)
ax.set_xticklabels(tick_labels)
ax.set_ylabel("Max flood depth within footprint (m)")
ax.set_title(
    "Flood depth at exposed buildings by category\n"
    "(box = middle 50%, line = median, whiskers exclude outliers; "
    "n = exposed buildings, present / PGW)"
)
ax.legend(
    handles=[
        Patch(color="tab:blue", label="Present"),
        Patch(color="tab:red", label="PGW"),
